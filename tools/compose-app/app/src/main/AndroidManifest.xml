<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Plain HTTP, so the network demo needs no certificate on the device. This is a demo app. -->
    <application
        android:usesCleartextTraffic="true"
        android:label="EmuLabZip Compose"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- A WebView page, and what the app's links open: an app link that is verified against the site's
             assetlinks.json, and a link of the app's own. See docs/deep-links.md. -->
        <activity android:name=".WebViewActivity" android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="emulabzip.luispeixoto.dev" android:pathPrefix="/demo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="emulabzip-demo" android:host="open" />
            </intent-filter>
        </activity>
        <!-- Exposed on purpose, for the security audit to find (see WeakDemo.kt). -->
        <receiver android:name=".PingReceiver" android:exported="true">
            <intent-filter>
                <action android:name="dev.emulabzip.composedemo.ACTION_PING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
